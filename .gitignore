
# ============================================
# SAGE-Pose - Git Ignore
# ============================================

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Ambientes virtuais
.venv/
venv/
env/

# Credenciais
.env
.env.*
!.env.example

# Cache do SAGE-Pose
cache/*
!cache/.gitkeep

# Dados e imagens
assets/cameras/
experiments/
*.jpg
*.jpeg
*.png
*.bmp
*.tif
*.tiff
*.webp

# Modelos CAD
*.ply

# Resultados e logs
results/
outputs/
runs/
logs/
wandb/
tensorboard/
.ipynb_checkpoints/

# Editores
.vscode/
.idea/

# Arquivos temporarios
*.log
*.tmp

# Backup do ambiente Conda
environment.backup.yml

